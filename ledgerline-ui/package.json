{
  "name": "ledgerline-ui",
  "version": "0.1.0",
  "description": "Ledgerline UI \u2014 free copy-paste React and Next.js components (fork of Opensource UI, MIT)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/froa10/Test.git"
  },
  "homepage": "https://ledgerline-ui.vercel.app",
  "bugs": {
    "url": "https://github.com/froa10/Test/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/deploy/strip-worker-incompatible-assets.mjs",
    "prebuild": "npm run check:showcase",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:showcase": "node scripts/checks/check-showcase-files.mjs",
    "check:catalog": "node scripts/checks/check-catalog-integrity.mjs",
    "check:design": "node scripts/checks/check-design-guard.mjs",
    "check:jsx-space": "node scripts/checks/check-jsx-text-space.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:showcase && npm run check:catalog && npm run check:design && npm run check:jsx-space && npm run test && npm run build && npm run test:e2e",
    "verify:quick": "npm run format:check && npm run lint && npm run typecheck && npm run check:showcase && npm run check:catalog && npm run check:design && npm run check:jsx-space && npm run test",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "node scripts/deploy/cloudflare-pages-deploy.mjs",
    "pages:dev": "npm run cf:dev",
    "pages:deploy": "npm run cf:deploy",
    "pages:upload": "node -e \"console.error('Use npm run cf:deploy for this Worker project. pages:upload is Cloudflare Pages only.'); process.exit(1)\""
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.139.0"
  }
}
